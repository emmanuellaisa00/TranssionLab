<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:TranssionLab.ViewModels.Pages;assembly=TranssionLab.ViewModels">

  <!-- PAGE 15: OPERATION HISTORY -->
  <DataTemplate DataType="{x:Type pages:OperationHistoryViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Reload Audit Trail" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="Persistent Servicing Operation History" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Immutable local audit trail of bootloader, sideload, and partition flashing operations with verification results and saved JSON report paths."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" Height="440">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Operation ID" Binding="{Binding OperationId}" Width="135" />
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
            <DataGridTextColumn Header="Operation" Binding="{Binding OperationName}" Width="210" />
            <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="140" />
            <DataGridTextColumn Header="Succeeded" Binding="{Binding Succeeded}" Width="80" />
            <DataGridTextColumn Header="Verification Result" Binding="{Binding VerificationResult}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 16: LIVE LOGS & DIAGNOSTIC EXPORT (Section 8) -->
  <DataTemplate DataType="{x:Type pages:LiveLogsViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <WrapPanel Margin="0,0,0,10">
            <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,6" ToolTip="Search action, output, serial, or error" />
            <ComboBox Width="130" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedMinSeverity}" Margin="0,0,10,6" />
            <Button Content="Refresh" Command="{Binding RefreshLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" />
            <Button Content="Clear Display (Keep Archive)" Command="{Binding ClearDisplayOnlyCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,6" />
            <Button Content="Export TXT" Command="{Binding ExportTxtCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6" />
            <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6" />
            <Button Content="Copy Troubleshooting Bundle" Command="{Binding CopyTroubleshootingBundleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" />
          </WrapPanel>

          <DataGrid ItemsSource="{Binding VisibleEntries}" Height="310" Margin="0,0,0,12" FontFamily="{StaticResource MonoFont}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="55" />
              <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80" />
              <DataGridTextColumn Header="Provider" Binding="{Binding ProtocolProvider}" Width="185" />
              <DataGridTextColumn Header="Action" Binding="{Binding RequestedAction}" Width="260" />
              <DataGridTextColumn Header="Verification / Error" Binding="{Binding VerificationResult}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Redacted Copyable Troubleshooting Bundle" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding TroubleshootingBundleText, Mode=OneWay}" IsReadOnly="True" Height="150" FontFamily="{StaticResource MonoFont}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 17: SETTINGS (Section 10 Offline-First) -->
  <DataTemplate DataType="{x:Type pages:SettingsViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Offline-First Application &amp; Tool Configuration" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,6" />
          <TextBlock Text="TranssionLab operates 100% offline with zero cloud accounts, activation locks, or telemetry. Configure local paths for redistributable or OEM-authorized utilities below."
                     Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

          <TextBlock Text="ADB Executable Path (adb.exe)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

          <TextBlock Text="Fastboot Executable Path (fastboot.exe)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding FastbootPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

          <TextBlock Text="Optional External Licensed MediaTek META Library Path (MetaCore.dll / SPMETA_DLL.dll)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding OptionalMetaDllPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

          <TextBlock Text="Local Workspace Data Directory (Logs, Reports, Custom Profiles, Staging)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Text="{Binding WorkspaceDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

          <CheckBox IsChecked="{Binding AutoPollUsb}" Content="Enable background USB / PnP arrival &amp; removal monitoring" />
          <CheckBox IsChecked="{Binding RedactLogs}" Content="Automatically redact private keys, bearer tokens, and secrets in logs and exports (Recommended)" />
          <CheckBox IsChecked="{Binding StrictProfileBeforeFlash}" Content="Require verified TECNO / Infinix / itel Device Profile match before building flash plans" />

          <Button Content="Save Offline Configuration" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 18: DOCUMENTATION & ABOUT -->
  <DataTemplate DataType="{x:Type pages:DocumentationAboutViewModel}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <TextBlock Text="Offline Reference Manual" Style="{StaticResource SectionHeadingStyle}" />
          <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" Background="#0F172A" Foreground="{StaticResource PrimaryTextBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" Height="460">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Visibility="{Binding SelectedTopic, Converter={StaticResource NullToCollapsed}}">
        <StackPanel DataContext="{Binding SelectedTopic}">
          <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeadingStyle}" FontSize="17" />
          <TextBox Text="{Binding MarkdownContent, Mode=OneWay}" IsReadOnly="True" Height="450" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

</ResourceDictionary>
