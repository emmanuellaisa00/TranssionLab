<Window x:Class="TranssionLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranssionLab — Universal Android Servicing Suite (TECNO / Infinix / itel)"
        Width="1360"
        Height="860"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: 18-PAGE NAVIGATION -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Brand Header -->
        <Border DockPanel.Dock="Top" Padding="18,16" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="TRANSSIONLAB" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Universal Servicing Suite v1.0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0" />
            <Border Background="#064E3B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
              <TextBlock Text="OFFLINE-FIRST • VERIFIED" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold" />
            </Border>
          </StackPanel>
        </Border>

        <!-- All 18 Pages ListBox -->
        <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding CurrentPage}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#1D4ED8" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding IconGlyph}" Width="24" FontSize="13" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding PageNumber, StringFormat=#{0:D2}}" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageTitle}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- RIGHT WORKSPACE AREA -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- TOP GLOBAL DEVICE SELECTOR BAR -->
      <Border Grid.Row="0" Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock Text="Target Device:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="280"
                      ItemsSource="{Binding ConnectedDevices}"
                      SelectedItem="{Binding SelectedDeviceItem}"
                      DisplayMemberPath="DeviceKey"
                      Margin="0,0,10,0" />
            <Button Content="Scan Devices" Command="{Binding GlobalScanDevicesCommand}" Style="{StaticResource PrimaryButtonStyle}" />
          </StackPanel>

          <StackPanel>
            <TextBlock Text="{Binding CurrentPage.PageTitle}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding GlobalConnectionHeadline}" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- EXPLICIT MULTI-DEVICE SELECTION MANDATORY WARNING BANNER -->
      <Border Grid.Row="1"
              Background="#78350F"
              BorderBrush="#F59E0B"
              BorderThickness="0,0,0,1"
              Padding="20,8"
              Visibility="{Binding RequiresExplicitSelectionBanner, Converter={StaticResource BoolToVis}}">
        <TextBlock Foreground="#FEF3C7" FontWeight="SemiBold" FontSize="12.5">
          ⚠ Multiple phones are connected simultaneously. TranssionLab never silently selects a device — choose the exact target device in the selector above before running operations.
        </TextBlock>
      </Border>

      <!-- MAIN SCROLLABLE PAGE CONTENT -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
        <StackPanel>
          <!-- Page Status & Busy Progress Strip -->
          <Border Background="#111827" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
            <DockPanel>
              <ProgressBar DockPanel.Dock="Right"
                           Width="140"
                           Height="6"
                           IsIndeterminate="True"
                           Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}}"
                           Background="#1E293B"
                           Foreground="{StaticResource AccentCyanBrush}" />
              <TextBlock Text="{Binding CurrentPage.StatusBanner}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <ContentControl Content="{Binding CurrentPage}" />
        </StackPanel>
      </ScrollViewer>

      <!-- BOTTOM LIVE TELEMETRY STATUS BAR -->
      <Border Grid.Row="3" Background="#0F1623" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="18,7">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="Open Live Logs (#17)"
                  Command="{Binding NavigateToPageCommand}"
                  CommandParameter="17"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Padding="10,3"
                  FontSize="11" />
          <TextBlock Text="{Binding LatestLogLine}"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11.5"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
